# Copy to .env (or .env.local) and fill in. Never commit the real file.

# --- Required ---------------------------------------------------------------
# Neon connection string (use the pooled or direct URL, with sslmode=require).
DATABASE_URL='postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require'

# Signs session cookies. Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# Public URL of the app, and the environment name: local | staging | production.
# The demo-login helper on /login is shown only when this is "local".
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=local

# --- Optional: single sign-on (Authentik, Keycloak, any OIDC provider) -------
# Set all three to show the "Sign in with SSO" button. Leave all empty to hide it.
# Issuer example (Authentik): https://authentik.example.com/application/o/thlush/
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Optional ----------------------------------------------------------------
# Required when self-hosting behind your own domain or proxy (not needed on Vercel).
# AUTH_TRUST_HOST=true

# Table-name prefix for every database object. Changing it after the first
# migration means generating and applying new migrations.
# DB_TABLE_PREFIX=app_

# Password given to the demo users by `npm run db:seed` (default: Password@123).
# SEED_PASSWORD=
